# Notification Service Configuration
PORT=3006
NODE_ENV=development

# RabbitMQ
RABBITMQ_URL=amqp://devuser:devpassword@localhost:5672

# Email: Resend if its key is set, else SendGrid, else nothing is sent and the
# notification step is SKIPPED. Same values as tenant-service.
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="Liftoff <noreply@example.com>"

# Links in the emails point here.
FRONTEND_URL=http://localhost:5173

# tenant-service's internal API: who in the company to email, and about which customer.
# INTERNAL_API_TOKEN must match tenant-service's.
TENANT_SERVICE_URL=http://localhost:3001
INTERNAL_API_TOKEN=
