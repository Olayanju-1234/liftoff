# Credentials Service Configuration
PORT=3003
NODE_ENV=development

# Database (same as tenant-service; the Credential table lives in the credentials schema, pinned in prisma/schema.prisma)
DATABASE_URL="postgresql://devuser:devpassword@localhost:5432/tenant_db?schema=public"

# RabbitMQ
RABBITMQ_URL=amqp://devuser:devpassword@localhost:5672
