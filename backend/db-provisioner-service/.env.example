# DB Provisioner Service Configuration
PORT=3002
NODE_ENV=development

# Database (same as tenant-service; this service owns no tables and only creates tenant_<subdomain> schemas)
DATABASE_URL="postgresql://devuser:devpassword@localhost:5432/tenant_db?schema=public"

# RabbitMQ
RABBITMQ_URL=amqp://devuser:devpassword@localhost:5672
