// Per-service output: the default (hoisted node_modules/.prisma/client) is shared by
// every workspace, so the last service to run `prisma generate` overwrote the others.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/db-provisioner-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // No models: this client only runs raw CREATE SCHEMA. The unused schema keeps a stray
  // `prisma db push` here from diffing public and dropping tenant-service's tables.
  schemas  = ["db_provisioner"]
}
