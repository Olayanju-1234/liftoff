# Billing Service Configuration
PORT=3005
NODE_ENV=development

# RabbitMQ
RABBITMQ_URL=amqp://devuser:devpassword@localhost:5672

# tenant-service's internal API: where each company's Stripe key and prices come from.
# INTERNAL_API_TOKEN must match tenant-service's. Without both, real tenants fail at
# billing (dead letter → FAILED); test tenants are still SKIPPED.
TENANT_SERVICE_URL=http://localhost:3001
INTERNAL_API_TOKEN=

# There is no platform-wide Stripe key any more: each company connects its own account
# through PUT /organisation { stripeSecretKey, stripePrices } (Settings → Billing).
