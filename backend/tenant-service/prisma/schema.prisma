// Per-service output: the default (hoisted node_modules/.prisma/client) is shared by
// every workspace, so the last service to run `prisma generate` overwrote the others.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenant Service Schema ---

model Tenant {
  id        String   @id @default(cuid())
  // Unique per organisation (below), not across the platform: two companies can both have an "Acme".
  name      String   // e.g., "Acme Inc."
  subdomain String   // e.g., "acme"
  // The Postgres schema db-provisioner created. Older rows used tenant_<subdomain>; new ones
  // are prefixed with the organisation handle so two companies' "acme" don't share a schema.
  schemaName String?
  status    TenantStatus @default(PROVISIONING)
  planId    String
  
  plan      Plan     @relation(fields: [planId], references: [id])
  users     User[]   @relation("TenantMembers") // A tenant can have many users
  events    EventLog[]

  // Tenants are a company's customers: everyone in the organisation sees them.
  // A tenant without an organisation is hidden from everyone.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  // The user who created it (null when made with an API key). Kept for audit, no longer scopes reads.
  ownerId   String?
  owner     User?    @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Signup used to provision a tenant for the signer's own company; those rows stay but are
  // not customers, so every listing skips them.
  isWorkspace Boolean @default(false)
  // Test mode: provisioned like a real tenant, but billing is SKIPPED and it never counts
  // towards the organisation's quotas.
  isTest Boolean @default(false)

  // Provisioning Steps Status
  dbStatus          StepStatus @default(PENDING)
  dnsStatus         StepStatus @default(PENDING)
  credentialsStatus StepStatus @default(PENDING)
  billingStatus     StepStatus @default(PENDING)
  notificationStatus StepStatus @default(PENDING)
  
  // SHA-256 of the public status-page token (derived per tenant from STATUS_TOKEN_SECRET),
  // so GET /status/:token is one indexed lookup and the token itself is never stored.
  statusTokenHash String? @unique

  // What billing created in the company's Stripe account, from tenant.billing.active.
  // Null when billing was skipped (test tenant, or Stripe not connected).
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Cancellation fields
  cancelledAt  DateTime?
  cancelReason String?

  // Deprovisioning: each worker's teardown, null until DELETE (or cancel from ACTIVE/FAILED).
  // The tenant becomes DELETED once all three are SUCCESS or SKIPPED.
  teardownDbStatus          StepStatus?
  teardownCredentialsStatus StepStatus?
  teardownBillingStatus     StepStatus?
  // true while the tenant holds its name and subdomain; null once it is DELETED and its
  // schema is dropped. Postgres treats NULLs as distinct, so a removed customer can be
  // added again under the same name.
  live Boolean? @default(true)

  deletedAt DateTime? // Soft delete: set with status DELETED; the row and its events stay
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, subdomain, live])
  @@unique([organisationId, name, live])
  @@index([ownerId])
  @@index([organisationId])
}

// The account holder: a SaaS company whose customers are its tenants.
model Organisation {
  id     String @id @default(cuid())
  name   String
  handle String @unique
  // The company's own domain for tenant addresses, e.g. "acme.app" → globex.acme.app.
  // Display only until DNS is real; API responses fall back to the platform domain.
  baseDomain String?

  // Quotas. Raised by hand (SQL) for a company that needs more; test tenants never count.
  maxActiveTenants    Int @default(10)
  maxProvisionsPerDay Int @default(50)
  provisions ProvisionLog[]

  // Stored raw, not hashed, because every delivery is signed with it. The API returns it once.
  webhookUrl    String?
  webhookSecret String?

  // The company's own Stripe account. The key is AES-256-GCM encrypted with ORG_SECRETS_KEY
  // and never returned; billing-service fetches it over the internal API when it subscribes
  // a tenant. Null means Stripe is not connected and the billing step is SKIPPED.
  stripeSecretKeyEncrypted String?
  // { starter, pro, enterprise } → Stripe Price ID, any of them absent.
  stripePrices             Json?

  // Set when someone dismissed the finished onboarding checklist on the Simple home;
  // it is never shown to the company again.
  onboardingDismissedAt DateTime?

  users   User[]
  tenants Tenant[]
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  // Enough of the key to recognise it in a list; the rest is only ever stored hashed.
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([organisationId])
}

// One row per counted provision, so the rolling-day quota survives tenants being deleted.
model ProvisionLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tenantId       String?
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
}

// One row per Idempotency-Key a company sends on POST /tenants. The response is stored
// once the request succeeds; until then the row reserves the key against a concurrent retry.
model IdempotencyKey {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  requestHash    String
  response       Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([organisationId, key])
  @@index([expiresAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  password     String?  // Nullable for OAuth-only users
  refreshToken String?  // For JWT refresh token rotation
  role         UserRole @default(USER)
  
  // OAuth fields
  provider     String?  // 'local', 'google', 'github'
  providerId   String?  // OAuth provider's user ID
  picture      String?  // Profile picture URL from OAuth
  
  // Email verification
  emailVerified    Boolean   @default(false)
  verificationToken String?
  verificationExpiry DateTime?
  // Replaces email only once the verification token above is confirmed.
  pendingEmail     String?

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?
  
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  // Legacy: the workspace tenant signup used to provision. New users have none.
  tenantId  String?
  tenant    Tenant?  @relation("TenantMembers", fields: [tenantId], references: [id], onDelete: Cascade)
  ownedTenants Tenant[] @relation("TenantOwner")
  settings  Settings?
  
  deletedAt DateTime? // Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
}

model Plan {
  id        String   @id @default(cuid()) // e.g., "plan_basic", "plan_enterprise"
  name      String   @unique // e.g., "Basic", "Enterprise"
  maxUsers  Int
  maxApiKeys Int
  
  tenants   Tenant[] // A plan can be used by many tenants

  createdAt DateTime @default(now())
}

model EventLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType String
  status    String   // "Success", "Warning", "Error"
  payload   Json?
  timestamp DateTime @default(now())
}

model Settings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Profile
  firstName          String   @default("")
  lastName           String   @default("")
  
  // Notification Preferences
  emailNotifications Boolean  @default(true)
  failedJobAlerts    Boolean  @default(true)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// --- Enums ---

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  CANCELLED
  // Teardown in flight: schema, API key and subscription are being removed.
  DEPROVISIONING
  // Torn down. Soft-deleted: hidden from lists, still readable by id with its events.
  DELETED
}

enum UserRole {
  ADMIN
  USER
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  CANCELLED
  // The step was deliberately not run (billing on a test tenant). Terminal, like SUCCESS.
  SKIPPED
}